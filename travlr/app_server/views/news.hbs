<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>News - Travlr Getaways Website Template</title>
	<link rel="stylesheet" href="css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header }}
			<div id="contents">
				<div class="box">
					<div>
						<div id="news" class="body">
							<div class="sidebar">
								<h3>Latest News</h3>
								<ul>
									{{#each newsLatest}}
									<li>
										<a href="/api/newsLatest/{{this.code}}" target="_blank" rel="noopener noreferrer">{{this.title}}</a>
									</li>
									{{/each}}
								</ul>
								<h3>Vaction Tips</h3>
								<ul>
									{{#each newsTips}}
									<li>
										<a href="/api/newsTips/{{this.code}}" target="_blank" rel="noopener noreferrer">{{this.title}}</a>
									</li>
									{{/each}}
								</ul>
							</div>
							<div>
								<h1>News</h1>
								<img src="images/kayak.jpg" alt="Img">
								{{#each newsFeatured}}
									<a href="/api/newsFeatured/{{this.code}}" target="_blank" rel="noopener noreferrer"><img src="images/{{this.image}}" alt="Img"></i></a>
									<a href="/api/newsFeatured/{{this.code}}" target="_blank" rel="noopener noreferrer"><h2>{{this.title}}</h2></a>
									<span class="time">{{this.pubDate}}<br> by: {{this.author}}</span>
									{{{this.description}}}
								{{/each}}
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer }}
	</div>
</body>
</html>